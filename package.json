{
  "name": "ecomanager-pro-tests",
  "version": "1.0.0",
  "description": "Suite de pruebas QA para EcoManager Pro",
  "private": true,
  "scripts": {
    "test:unit": "jest tests/jest --coverage",
    "test:e2e": "playwright test tests/playwright",
    "test:e2e:headed": "playwright test tests/playwright --headed",
    "test:lighthouse": "node tests/lighthouse/run-lighthouse.js",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:lighthouse"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "chrome-launcher": "^1.2.1",
    "jest": "^29.7.0",
    "lighthouse": "^11.7.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/jest/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "tests/jest/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageReporters": [
      "text",
      "html"
    ]
  }
}
